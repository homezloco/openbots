# Copy to .env and fill in the providers you plan to use.
# Only agents configured with a given provider need its key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# For the "openai-compatible" provider (Ollama, Groq, Together, etc).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional: enables OpenAI-embedding rerank for search_knowledge (deliberately
# separate from OPENAI_API_KEY above — that key may be set only so some
# unrelated node can use GPT as a fallback provider, which has nothing to do
# with consenting to send file excerpts from a fileAccessRoot to OpenAI).
# Unset = search_knowledge still works, lexical-only, nothing leaves the box.
SEARCH_KNOWLEDGE_EMBEDDING_API_KEY=

DATABASE_URL=postgres://openbots:openbots@localhost:5432/openbots
# Host port 6380 — docker-compose maps it there to avoid clashing with a
# local Redis already on 6379. Inside compose, api/worker still use
# redis://redis:6379 (see docker-compose.yml).
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:3000
# Set to "true" only once you're serving over HTTPS (e.g. behind a TLS-terminating
# reverse proxy) — the session cookie won't be sent back over plain HTTP otherwise.
COOKIE_SECURE=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Generate with: openssl rand -hex 32 — required to store/read per-graph provider credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Comma-separated absolute paths an agent's fileAccessRoot is allowed to be
# set to (or a subdirectory of). Empty/unset = no agent can be granted file
# access at all — this is intentionally secure-by-default, since any signed-up
# user can configure an agent's fileAccessRoot themselves.
# Example: ALLOWED_FILE_ACCESS_ROOTS=/data/repos,/home/you/projects
ALLOWED_FILE_ACCESS_ROOTS=

# Separate, independent allowlist for the write_file/edit_file tools — a
# node having read access to a path (above) does NOT imply write access
# to it. Empty/unset = no agent can ever write anywhere, even if
# ALLOWED_FILE_ACCESS_ROOTS covers the same path. Every write is isolated
# to a fresh git worktree/branch (see docs/orchestration.md) — the
# fileAccessRoot must be a real git repo for a node to actually use
# write_file/edit_file. Also requires the operator to add a more-specific
# `:rw` bind mount per project in docker-compose.override.yml — see
# CLAUDE.md — since the default mount is read-only for everything.
ALLOWED_FILE_WRITE_ROOTS=

# Comma-separated "username@host" pairs a node's sshTarget is allowed to be
# set to, for the run_remote_command tool. Empty/unset = no agent can ever
# be granted remote command execution at all — secure by default, same
# reasoning as ALLOWED_FILE_ACCESS_ROOTS. A node can still only run the
# exact commands a human pre-configures on it (see AgentSettingsForm), never
# an arbitrary one.
# Example: ALLOWED_SSH_HOSTS=ubuntu@100.66.221.81,deploy@203.0.113.9
ALLOWED_SSH_HOSTS=

# Comma-separated http(s) URL prefixes a node's mcpServers[].url must sit
# on (scheme+host, optional path). Empty/unset = no agent can be granted
# MCP client access at all — SSRF protection, same reasoning as
# ALLOWED_FILE_ACCESS_ROOTS. Keep every legitimate prefix in the SAME
# value (e2e fixture + real servers); overwriting drops the others.
# Example: ALLOWED_MCP_SERVERS=http://mcp-echo:3930,http://127.0.0.1:3930,https://api.githubcopilot.com
# docker compose starts a fixture at http://mcp-echo:3930/mcp (worker DNS).
# Local `pnpm dev:worker` should allowlist http://127.0.0.1:3930 instead.
ALLOWED_MCP_SERVERS=

# Optional: powers AgentSettingsForm's "Browse MCP servers" picker (search
# Smithery's MCP server directory instead of hand-typing a URL). Get a free
# key at https://smithery.ai/account/api-keys. Unset = the picker just says
# it isn't configured; everything else works exactly the same either way.
# This is a pure discovery convenience — a picked server still has to be
# added to ALLOWED_MCP_SERVERS above before any node can actually use it,
# and Smithery's "verified" only means publisher identity was checked, not
# that a server's code has been security-audited.
SMITHERY_API_KEY=

# Raw known_hosts-format text (can hold multiple hosts) for run_remote_command
# and any future SSH host beyond github.com. Generate with, e.g.:
#   ssh-keyscan 100.66.221.81
# Pinned rather than trusted on first connection (TOFU) — there's no public
# key-discovery API for a personal server the way GitHub publishes /meta.
SSH_KNOWN_HOSTS=

# Optional: the pc_telemetry tool's read-only WebSocket source (thermal/
# battery only — see docs/adapters.md). Only reachable if the worker can
# see the host's loopback interface, e.g. via network_mode: host in a
# docker-compose.override.yml. Defaults to ws://127.0.0.1:52341, the
# linux-command-centre default.
PC_TELEMETRY_WS_URL=

# Optional OTLP HTTP traces for hop-by-hop runs (Jaeger / Tempo / Honeycomb).
# Unset = no export. Base URL or full .../v1/traces; hops never include prompt text.
# Example: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated headers: Authorization=Bearer xxx
OTEL_EXPORTER_OTLP_HEADERS=

# dispatch_to_graph blocks waiting on the target graph's run, up to this
# many ms, before degrading to outcome:"still_running" (the target keeps
# running either way — this only bounds how long the CALLER waits).
# Default 480000 (8 min) if unset. Lower this only for deterministic e2e
# testing of the timeout-fallback path, not for normal/production use —
# a low value here makes every real dispatch time out fast.
DISPATCH_POLL_TIMEOUT_MS=

# The uid:gid the api/worker containers run as. Defaults to 1000:1000,
# which matches the first non-root user on most Linux installs. Set these
# to your own `id -u` / `id -g` if they differ — otherwise agent file
# writes (which land in a git worktree inside a bind-mounted host
# directory) leave files your host user cannot modify, and the next
# `git add` fails with "insufficient permission for adding an object to
# repository database". Not used on macOS/Windows Docker Desktop, where
# the VM already handles ownership mapping.
DOCKER_UID=
DOCKER_GID=

# Per-hop wall-clock budget for a normal node, in ms. Default 180000 (3
# min) if unset — tuned for a model call plus a few tool calls. Raise
# this if write-capable nodes doing real multi-file code tasks hit
# "exceeded 180000ms timeout" while still under the tool-step cap
# (found by dogfooding — see PLAN.md). Dispatch-capable nodes keep their
# own larger budget regardless (DISPATCH_HOP_TIMEOUT_MS in code).
NODE_TIMEOUT_MS=

# BullMQ worker concurrency (jobs/hops processed in parallel). Default 10
# if unset. A blocking dispatch_to_graph call holds its own hop's worker
# slot for the whole wait, on top of the target run's own hop(s) each
# needing slots too — raise this if you lean on dispatch_to_graph heavily
# and see dispatched work stall waiting for a free worker.
WORKER_CONCURRENCY=

# Enables the run_code tool (sandboxed Python/JavaScript execution, no
# network access). Empty/unset = the tool is never granted to any node,
# however configured — secure by default, same reasoning as
# ALLOWED_FILE_ACCESS_ROOTS. One value for the whole deployment; not a
# forced single vendor — pick whichever backend fits your deployment:
#   e2b     - Firecracker microVMs, hosted only (BYOK). Each node's owner
#             adds their own E2B API key at /settings ("sandbox_e2b").
#   daytona - Hosted only since Daytona's June 2026 move to a closed
#             platform (see PLAN.md) — BYOK at /settings ("sandbox_daytona"),
#             same shape as e2b.
#   local   - Self-hosted, no API key: runs against the "sandbox" (Piston)
#             service below, which only starts with
#             `docker compose --profile sandbox-local up`. One-time setup
#             after first start:
#               docker compose --profile sandbox-local exec sandbox cli/index.js ppman install python
#               docker compose --profile sandbox-local exec sandbox cli/index.js ppman install node
#             Piston's own docker-compose.yaml requires `privileged: true`
#             for its isolate-based sandboxing — a real, intentional
#             tradeoff for a genuinely self-hosted option (see PLAN.md).
SANDBOX_PROVIDER=

# Hard cap on a single run_code execution, in ms. Default 60000, clamped
# to 120000 regardless of what's set here — kept well under the default
# per-hop timeout so run_code needs no engine-level timeout extension.
SANDBOX_TIMEOUT_MS=

# Only read when SANDBOX_PROVIDER=local. Default matches the "sandbox"
# service's compose name — only change this if you renamed that service.
PISTON_API_URL=

# Opts anthropic-provider nodes into Anthropic's explicit prompt-caching
# (cache_control on the system prompt, 5-minute TTL). Empty/unset = off,
# today's exact behavior unchanged. Real tradeoff, not a free win: a
# cache write costs 1.25x normal input price and only pays off if the
# SAME node is called again within 5 minutes — a real win for chat
# sessions, consensus fan-out, and dispatch-revision loops; a real
# (small) loss for a node only ever invoked once. OpenAI's own caching
# is automatic and already accounted for in cost estimates regardless of
# this setting — this only affects Anthropic.
ANTHROPIC_PROMPT_CACHING=
